# Settings for reaching the EvoHub. Copy this file to .env and edit .env.

# Address of the EvoHub on the laboratory network.
EVOHUB_HOST=evohub.local

# The database and the message broker run on the EvoHub,
# so both follow EVOHUB_HOST unless set explicitly.
DB_HOST=${EVOHUB_HOST}
DB_PORT=5432
DB_NAME=postgres
DB_USER=postgres
DB_PASS=postgres

MQTT_HOST=${EVOHUB_HOST}
MQTT_PORT=1883
MQTT_USER=service_account
MQTT_PASS=service_pass
